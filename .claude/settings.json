{
  "enabledPlugins": {
    "claude-security@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",

      "Bash(git -C:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",

      "Bash(gh api:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo:*)",

      "Bash(make:*)",
      "Bash(npx markdownlint-cli2:*)",
      "Bash(npx prettier:*)",

      "Skill",
      "WebFetch",
      "WebSearch"
    ],
    "deny": []
  },
  "worktree": {
    "bgIsolation": "worktree"
  }
}
